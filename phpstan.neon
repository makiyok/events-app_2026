includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Livewire の単一ファイルコンポーネント（⚡profile.blade.php）からだけ使われており、PHPStan の解析対象外のため未使用に見える
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
